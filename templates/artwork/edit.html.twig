<style>
    body { font-family: sans-serif; max-width: 600px; margin: 40px auto; padding: 0 20px; background: #f5f5f5; }
    h1 { color: #333; }
    form div { margin-bottom: 15px; }
    label { display: block; font-weight: bold; margin-bottom: 5px; color: #555; }
    input, textarea, select { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
    button { background: #333; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; }
    button:hover { background: #555; }
    a { display: inline-block; margin-top: 15px; color: #333; }
</style>

<h1>Edit: {{ artwork.title }}</h1>
<p>Current image:</p>
<img src="{{ artwork.imageUrl }}" alt="{{ artwork.title }}" width="200">

{{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
    {{ form_row(form.title) }}
    {{ form_row(form.description) }}
    {{ form_row(form.creationDate) }}
    {{ form_row(form.imageFile) }}
    {{ form_row(form.artist) }}
    <button type="submit">Save Changes</button>
{{ form_end(form) }}

<a href="{{ path('allArtworks') }}">Cancel</a>