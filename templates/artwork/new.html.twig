<h1>Add New Artwork</h1>

{{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
    {{ form_row(form.title) }}
    {{ form_row(form.description) }}
    {{ form_row(form.creationDate) }}
    {{ form_row(form.imageFile) }}
    {{ form_row(form.artist) }}
    <a href="{{ path('newArtist') }}">Add a new artist</a><br><br>
    <button type="submit">Save Artwork</button>
{{ form_end(form) }}

<a href="{{ path('allArtworks') }}">Back to Gallery</a>
