{# index.html.twig #}
<html>
	<head>
		<title>Artwork Details</title>
	</head>
	<body>
		<h2>Current Artwork</h2>

		<table border="1">
			<tr>
				<th>Title</th>
				<td>{{ artwork.title }}</td>
			</tr>
			<tr>
				<th>Artist</th>
				<td>{{ artwork.artist.name }}</td>
			</tr>
			<tr>
				<th>Creation Date</th>
				<td>{{ artwork.creationDate|date('Y-m-d') }}</td>
			</tr>
			<tr>
				<th>Description</th>
				<td>{{ artwork.description }}</td>
			</tr>
			<tr>
				<th>Image</th>
				<td><img src="{{ artwork.imageUrl }}" alt="{{ artwork.title }}" width="300"></td>
			</tr>
		</table>
		<a href="{{ path('allArtworks') }}">All Artworks</a>
		<a href="{{ path('home') }}">Home</a>
		<a href="{{ path('editArtwork', {id: artwork.id}) }}">Edit Artwork</a>
		<a href="{{ path('deleteArtwork', {id: artwork.id}) }}">Delete Artwork</a>
	</body>
</html>
