<style>
    body { font-family: sans-serif; max-width: 800px; margin: 40px auto; padding: 0 20px; background: #f5f5f5; }
    h1, h2 { color: #333; }
    .artwork-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .artwork-card { background: white; padding: 10px; border-radius: 4px; }
    .artwork-card img { width: 100%; }
    a { color: #333; }
</style>

<h1>{{ artist.name }}</h1>
<p><strong>Nationality:</strong> {{ artist.nationality }}</p>
<p><strong>Born:</strong> {{ artist.birthDate|date('Y') }}</p>
<p>{{ artist.biography }}</p>

<h2>Artworks</h2>
<div class="artwork-grid">
    {% for artwork in artist.artworks %}
        <div class="artwork-card">
            <img src="{{ artwork.imageUrl }}" alt="{{ artwork.title }}">
            <h3><a href="{{ path('idArtwork', {id: artwork.id}) }}">{{ artwork.title }}</a></h3>
            <p>{{ artwork.creationDate|date('Y') }}</p>
        </div>
    {% endfor %}
</div>

<a href="{{ path('allArtists') }}">Back to Artists</a>